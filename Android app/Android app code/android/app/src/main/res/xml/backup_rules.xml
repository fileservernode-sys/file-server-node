<?xml version="1.0" encoding="utf-8"?>
<!--
  RemoteNode / ZdexCloud Android Data Extraction & Backup Rules (Phase 14.5)
  Excludes sensitive session files, Keystore-backed ciphertext, and device identity
  from cloud backup and device-to-device transfers.
-->
<data-extraction-rules>
    <cloud-backup>
        <!-- Exclude encrypted and legacy session files from cloud backup -->
        <exclude domain="file" path="rn_session.enc" />
        <exclude domain="file" path="rn_session.json" />
        <exclude domain="file" path="rn_session.enc.tmp" />
        <!-- Exclude persistent device identity tokens -->
        <exclude domain="sharedpref" path="net.remotenode.device_identity.xml" />
    </cloud-backup>
    <device-transfer>
        <!-- Exclude encrypted session files from device-to-device transfers -->
        <exclude domain="file" path="rn_session.enc" />
        <exclude domain="file" path="rn_session.json" />
        <exclude domain="file" path="rn_session.enc.tmp" />
        <exclude domain="sharedpref" path="net.remotenode.device_identity.xml" />
    </device-transfer>
</data-extraction-rules>
