<?xml version="1.0" encoding="utf-8"?>
<!--
  RemoteNode / ZdexCloud Android Network Security Configuration (Phase 14.5)
  SEC-14.1-06 Remediation: Restricts global cleartext traffic while preserving
  intentional local loopback communication for the native HTTP file server.
-->
<network-security-config>
    <!-- Base Configuration: Cleartext (HTTP) traffic is strictly forbidden across the entire application -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>

    <!--
      Explicit Local Loopback Exception:
      Required strictly for internal Android communication with the on-device local HTTP file server
      (127.0.0.1:8080 / localhost).
      All production and external traffic to ZdexCloud infrastructure (*.zdexcloud.com, gateway, APIs)
      is forced over TLS (HTTPS/WSS) with strict system certificate validation.
    -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
</network-security-config>
