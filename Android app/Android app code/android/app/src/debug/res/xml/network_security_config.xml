<?xml version="1.0" encoding="utf-8"?>
<!--
  RemoteNode / ZdexCloud Android Network Security Configuration (DEBUG ONLY)
  Allows cleartext communication with the local emulator host loopback (10.0.2.2)
  and local on-device servers strictly during development and debugging.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>

    <!-- Debug Cleartext Exceptions for Local Development and Emulator Host -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">10.0.2.2</domain>
    </domain-config>
</network-security-config>
