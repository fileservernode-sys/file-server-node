// Prisma Schema — Remote Android Personal File Server Platform (Control Plane)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// -----------------------------------------------------------------------------
// ENUMS
// -----------------------------------------------------------------------------

enum UserStatus {
  PENDING_VERIFICATION
  ACTIVE
  SUSPENDED
}

enum OtpPurpose {
  REGISTRATION_VERIFICATION
  LOGIN_2FA
  PASSWORD_RESET
}

enum DeviceStatus {
  ONLINE
  OFFLINE
  CONNECTING
  RECONNECTING
}

enum ServerInstanceStatus {
  STOPPED
  STARTING
  RUNNING
  ERROR
}

enum EndpointStatus {
  ACTIVE
  INACTIVE
}

enum ConnectionStatus {
  DISCONNECTED
  CONNECTING
  CONNECTED
  RECONNECTING
  FAILED
}

enum GatewayStatus {
  ACTIVE
  INACTIVE
  MAINTENANCE
}

enum NotificationRecordStatus {
  UNREAD
  READ
  ARCHIVED
}

enum ChannelDeliveryStatus {
  QUEUED
  PROCESSING
  DELIVERED
  FAILED
  RETRYING
  PERMANENTLY_FAILED
}

enum PushPlatform {
  ANDROID
  IOS
  WEB
}

enum AuditEventType {
  ACCOUNT_CREATED
  EMAIL_VERIFIED
  LOGIN_ATTEMPT_SUCCESS
  LOGIN_ATTEMPT_FAILED
  PASSWORD_RESET_REQUESTED
  PASSWORD_RESET_SUCCESS
  OTP_SENT
  OTP_VERIFIED
  DEVICE_REGISTERED
  DEVICE_CONNECTED
  DEVICE_DISCONNECTED
  SERVER_CREATED
  SERVER_STARTED
  SERVER_STOPPED
  ENDPOINT_ASSIGNED
  REMOTE_CONNECTION_CREATED
  REMOTE_CONNECTION_CONNECTED
  REMOTE_CONNECTION_DISCONNECTED
  REMOTE_CONNECTION_FAILED
  SERVER_ENDPOINT_ALLOCATED
  FILE_MANAGER_LOGIN_SUCCESS
  FILE_MANAGER_LOGIN_FAILED
  PUSH_TOKEN_REGISTERED
  PUSH_TOKEN_UPDATED
  PUSH_TOKEN_REVOKED
  NOTIFICATION_CREATED
  NOTIFICATION_DELIVERY_FAILED
}

// -----------------------------------------------------------------------------
// CORE ENTITIES
// -----------------------------------------------------------------------------

/// User Account (Control Plane Metadata Only — No User Files Stored Here)
model User {
  id            String       @id @default(cuid())
  email         String       @unique
  fullName      String?
  passwordHash  String?
  status        UserStatus   @default(PENDING_VERIFICATION)
  emailVerified Boolean      @default(false)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  otps                    EmailOtp[]
  sessions                UserSession[]
  devices                 Device[]
  auditEvents             AuditEvent[]
  notifications           NotificationRecord[]
  notificationPreferences UserNotificationPreferences?
  pushTokens              DevicePushToken[]

  @@index([email])
}

/// Email 6-Digit OTP Verification Model
model EmailOtp {
  id        String     @id @default(cuid())
  userId    String
  email     String
  otpCode   String
  purpose   OtpPurpose @default(REGISTRATION_VERIFICATION)
  expiresAt DateTime
  attempts  Int        @default(0)
  used      Boolean    @default(false)
  createdAt DateTime   @default(now())

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([email])
  @@index([userId])
}

/// Authenticated Platform Session Model
model UserSession {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
}

/// Registered Android Phone Device Node
model Device {
  id             String       @id @default(cuid())
  userId         String
  installationId String?
  deviceName     String
  platform       String       @default("Android")
  osVersion      String?
  appVersion     String?
  status         DeviceStatus @default(OFFLINE)
  lastSeenAt     DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  user          User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  servers       ServerInstance[]
  connections   DeviceConnection[]
  auditEvents   AuditEvent[]
  notifications NotificationRecord[]
  pushTokens    DevicePushToken[]

  @@unique([userId, installationId])
  @@index([userId])
  @@index([installationId])
  @@index([status])
  @@index([lastSeenAt])
}

/// Logical File Server Service Instance running on Android Device
model ServerInstance {
  id                String               @id @default(cuid())
  deviceId          String
  serverName        String?
  adminUsername     String?
  adminPasswordHash String?
  status            ServerInstanceStatus @default(STOPPED)
  startedAt         DateTime?
  lastHeartbeatAt   DateTime?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  device            Device          @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  endpoints         ServerEndpoint[]

  @@index([deviceId])
  @@index([status])
}

/// Assigned Remote Endpoint / Subdomain Mapping
model ServerEndpoint {
  id               String         @id @default(cuid())
  serverInstanceId String
  hostname         String         @unique
  status           EndpointStatus @default(ACTIVE)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  serverInstance   ServerInstance @relation(fields: [serverInstanceId], references: [id], onDelete: Cascade)

  @@index([hostname])
}

/// Remote Relay Gateway Node Entity
model GatewayNode {
  id              String        @id @default(cuid())
  hostname        String        @unique
  region          String?
  status          GatewayStatus @default(ACTIVE)
  lastHeartbeatAt DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  connections     DeviceConnection[]

  @@index([hostname])
  @@index([status])
}

/// Gateway Tunnel Connection Log / State
model DeviceConnection {
  id              String           @id @default(cuid())
  deviceId        String
  gatewayNodeId   String?
  connectionToken String?
  remoteEndpoint  String?
  status          ConnectionStatus @default(DISCONNECTED)
  connectedAt     DateTime?
  disconnectedAt  DateTime?
  lastHeartbeatAt DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  device          Device           @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  gatewayNode     GatewayNode?     @relation(fields: [gatewayNodeId], references: [id], onDelete: SetNull)

  @@index([deviceId])
  @@index([gatewayNodeId])
  @@index([status])
}

/// Control Plane Security & Operational Audit Log
model AuditEvent {
  id        String         @id @default(cuid())
  userId    String?
  deviceId  String?
  eventType AuditEventType
  metadata  Json?
  createdAt DateTime       @default(now())

  user      User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  device    Device?        @relation(fields: [deviceId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([deviceId])
  @@index([eventType])
}

// -----------------------------------------------------------------------------
// NOTIFICATION SYSTEM PERSISTENCE ENTITIES (Track 4 - Batch NT-1.2)
// -----------------------------------------------------------------------------

/// Persistent User-Facing Notification Record
model NotificationRecord {
  id             String                   @id @default(cuid())
  eventId        String
  userId         String
  deviceId       String?
  serverId       String?
  eventType      String
  category       String
  severity       String
  title          String
  body           String                   @db.Text
  deepLinkUri    String?
  webPath        String?
  metadata       Json?
  status         NotificationRecordStatus @default(UNREAD)
  readAt         DateTime?
  archivedAt     DateTime?
  occurredAt     DateTime                 @default(now())
  idempotencyKey String                   @unique
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt

  user       User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  device     Device?                 @relation(fields: [deviceId], references: [id], onDelete: SetNull)
  deliveries ChannelDeliveryRecord[]

  @@index([userId, createdAt])
  @@index([userId, status])
  @@index([eventId])
  @@index([idempotencyKey])
}

/// Persistent Transport Channel Delivery State Record
model ChannelDeliveryRecord {
  id                  String                @id @default(cuid())
  notificationId      String
  channel             String
  targetAddress       String?
  targetDeviceId      String?
  status              ChannelDeliveryStatus @default(QUEUED)
  attemptCount        Int                   @default(0)
  maxAttempts         Int                   @default(5)
  lastAttemptAt       DateTime?
  nextRetryAt         DateTime?
  deliveredAt         DateTime?
  failedAt            DateTime?
  processingStartedAt DateTime?
  processingWorkerId  String?
  providerMessageId   String?
  providerResponseCode String?
  failureReason       String?
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt

  notification NotificationRecord @relation(fields: [notificationId], references: [id], onDelete: Cascade)

  @@index([notificationId])
  @@index([channel, status])
  @@index([status, nextRetryAt])
  @@index([status, processingStartedAt])
}

/// Persistent User Notification Preferences Record
model UserNotificationPreferences {
  id                  String   @id @default(cuid())
  userId              String   @unique
  globalPushEnabled   Boolean  @default(true)
  globalEmailEnabled  Boolean  @default(true)
  categoryPreferences Json
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// Persistent FCM Device Push Token Entity
model DevicePushToken {
  id         String       @id @default(cuid())
  userId     String
  deviceId   String
  token      String       @unique
  platform   PushPlatform @default(ANDROID)
  appVersion String?
  isActive   Boolean      @default(true)
  lastSeenAt DateTime     @default(now())
  revokedAt  DateTime?
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  device Device @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([deviceId])
  @@index([userId, deviceId])
  @@index([isActive])
  @@index([lastSeenAt])
}
