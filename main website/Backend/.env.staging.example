# RemoteNode Backend Staging Environment Configuration (viewduration.com)
# DO NOT COMMIT ACTUAL SECRETS OR PASSWORDS TO VERSION CONTROL

NODE_ENV=staging
PORT=4000
HOST=0.0.0.0
DATABASE_URL="mysql://remotenode_staging_user:YOUR_SECURE_PASSWORD@127.0.0.1:3306/remotenode_staging"
CORS_ORIGIN="https://viewduration.com,https://*.viewduration.com"
LOG_LEVEL=info
API_BASE_URL="https://api.viewduration.com/api/v1"

# Base Domain Configuration (viewduration.com is used strictly as a staging/testing domain)
REMOTENODE_BASE_DOMAIN="viewduration.com"

# Serverbyt SMTP Configuration (Backend Only — Never exposed to Android or Frontend)
SMTP_HOST="smtp.serverbyt.com"
SMTP_PORT=587
SMTP_USERNAME="YOUR_SMTP_USERNAME"
SMTP_PASSWORD="YOUR_SMTP_PASSWORD"
SMTP_FROM_EMAIL="noreply@viewduration.com"
SMTP_FROM_NAME="RemoteNode Testing Platform"

# Remote Gateway Configuration
GATEWAY_HOST="0.0.0.0"
GATEWAY_PORT=4001
GATEWAY_PUBLIC_URL="https://viewduration.com"
GATEWAY_WS_URL="wss://gateway.viewduration.com"
GATEWAY_PUBLIC_BASE_URL="https://viewduration.com"
GATEWAY_PUBLIC_WS_URL="wss://viewduration.com"
GATEWAY_MAX_CONNECTIONS=1000
GATEWAY_AUTH_TIMEOUT_MS=10000
GATEWAY_REQUEST_TIMEOUT_MS=15000
GATEWAY_MAX_MESSAGE_SIZE_BYTES=10485760
GATEWAY_HEARTBEAT_INTERVAL_MS=30000
GATEWAY_MAX_AUTH_FAILURES=3
GATEWAY_RATE_LIMIT_RPM=600
GATEWAY_TRANSFER_TIMEOUT_MS=60000
GATEWAY_TRANSFER_CHUNK_SIZE_BYTES=1048576

# Optional TLS Certificate Paths (if TLS termination occurs in Node.js instead of reverse proxy)
# GATEWAY_TLS_CERT_PATH="/etc/letsencrypt/live/viewduration.com/fullchain.pem"
# GATEWAY_TLS_KEY_PATH="/etc/letsencrypt/live/viewduration.com/privkey.pem"
