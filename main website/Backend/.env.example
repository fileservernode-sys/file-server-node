# ==============================================================================
# ENVIRONMENT VARIABLES SPECIFICATION — CONTROL PLANE BACKEND
# Copy to .env for local development. Never commit real secrets to Git.
# ==============================================================================

# Server Execution
NODE_ENV=development
PORT=4000
HOST=0.0.0.0
LOG_LEVEL=debug

# Security & CORS
# In production, set to exact frontend origin URL (e.g. https://remotenode.net)
CORS_ORIGIN=http://localhost:3000,http://localhost:8080,http://127.0.0.1:8080
API_BASE_URL=http://localhost:4000/api/v1

# Database Configuration (Remote MySQL / Local MySQL)
# Format: mysql://USER:PASSWORD@HOST:PORT/DATABASE_NAME
DATABASE_URL=mysql://root:password@localhost:3306/remotenode_db

# Future Secret Placeholders (Prepared for future Auth/Gateway batches)
# JWT_SECRET=your-secret-key-at-least-32-chars
# SESSION_SECRET=your-session-secret-key
# GATEWAY_SECRET=your-gateway-tunnel-secret
# EMAIL_SMTP_URL=smtp://user:pass@smtp.example.com:587
