# Server Execution
NODE_ENV=development
PORT=4000
HOST=0.0.0.0
LOG_LEVEL=info

# Base Domain Configuration (zdexcloud.com for testing/staging)
REMOTENODE_BASE_DOMAIN=zdexcloud.com

# Security & CORS
CORS_ORIGIN=http://localhost:3000,http://localhost:8080,https://zdexcloud.com
API_BASE_URL=http://localhost:4000/api/v1

# Serverbyt MySQL Database Configuration
# Format: mysql://USER:<DB_PASSWORD>@HOST:PORT/DATABASE_NAME
DATABASE_URL="mysql://remotenode-3530333528a3:<DB_PASSWORD>@mysql.gb.stackcp.com:45878/remotenode-3530333528a3"

# Serverbyt / StackMail SMTP Configuration (Backend Only)
SMTP_HOST=smtp.stackmail.com
SMTP_PORT=465
SMTP_USERNAME=noreply@zdexcloud.com
SMTP_PASSWORD=<SMTP_PASSWORD>
SMTP_FROM_EMAIL=noreply@zdexcloud.com
SMTP_FROM_NAME="ZdexCloud Personal Cloud"

# Statutory Invoicing & Tax Entity Configuration (Phase 8.3)
